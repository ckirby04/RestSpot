{
  "name": "restspot",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @restspot/web",
    "build": "npm run build -w @restspot/web",
    "lint": "npm run lint -w @restspot/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}
