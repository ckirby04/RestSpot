# Copy to .env.local and fill in from Supabase → Project Settings → API.
# The anon/publishable key is safe to ship to browsers. NEVER put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Leave Supabase blank (or set VITE_BACKEND=local) to use the in-browser dev database
# with sample data and demo accounts.
# VITE_BACKEND=local

# Requires an Apple Developer account configured in Supabase Auth.
# VITE_ENABLE_APPLE_SIGNIN=true
